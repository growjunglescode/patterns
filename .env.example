APP_NAME=Patterns
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg2://patterns:patterns@localhost:5432/patterns
MEDIA_ROOT=./data/media
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Azure (leave empty for local disk storage)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=jaguar-media
# Recognition: opencv | embedding | trained | auto
RECOGNITION_ENGINE=auto
SUGGEST_THRESHOLD=0.68
MATCH_THRESHOLD=0.82
# Checkpoint from: python -m app.train_coat_reid --out data/models/coat-reid.pt
COAT_MODEL_PATH=
